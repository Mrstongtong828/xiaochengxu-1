{
  "bsonType": "object",
  "required": ["phone"],
  "permission": {
    "read": "doc._id == auth.uid",
    "create": true,
    "update": "doc._id == auth.uid",
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号"
    },
    "nickname": {
      "bsonType": "string",
      "description": "昵称"
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "updateTime": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
