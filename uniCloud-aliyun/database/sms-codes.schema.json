{
  "bsonType": "object",
  "required": ["phone", "code"],
  "permission": {
    "read": false,
    "create": true,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号"
    },
    "code": {
      "bsonType": "string",
      "description": "验证码"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "expireTime": {
      "bsonType": "timestamp",
      "description": "过期时间"
    },
    "used": {
      "bsonType": "bool",
      "description": "是否已使用"
    }
  }
}
